<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.so7o.ztrackpad"
    android:versionCode="1"
    android:versionName="0.1">

    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Z Trackpad"
        android:allowBackup="false"
        android:hardwareAccelerated="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Z Trackpad">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".TrackpadService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:description="@string/accessibility_service_description">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Runs with shell UID inside Shizuku's process: real input injection -->
        <service
            android:name=".ShellUserService"
            android:exported="false" />

        <!-- Scriptable control for the virtual display.
             See skills/ztrackpad-vdisplay/SKILL.md for the am broadcast invocation. -->
        <receiver
            android:name=".VDisplayReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="app.so7o.ztrackpad.VDISPLAY" />
            </intent-filter>
        </receiver>

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="app.so7o.ztrackpad.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false" />

    </application>
</manifest>
